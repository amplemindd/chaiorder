# Copy this file to backend-node/.env and fill in your GoDaddy values.
# Never commit the real .env file.

# --- GoDaddy MySQL (cPanel > MySQL Databases) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=cpanelprefix_chaiuser
DB_PASSWORD=your_db_password
DB_NAME=cpanelprefix_chaiorder

# --- App ---
JWT_SECRET=put_a_long_random_string_here
CLIENT_ORIGIN=https://yourdomain.com
APP_TZ=Asia/Kolkata
DB_TZ=+05:30

# First admin login (created automatically on first start if no admin exists)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=choose_a_strong_password
